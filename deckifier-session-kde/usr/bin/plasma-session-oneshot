#!/bin/bash
# One-shot Desktop Mode: switch the autologin back to Game Mode right away,
# so logging out (or rebooting) returns to Game Mode, then start Plasma.
/usr/bin/steamos-session-select gamescope --no-logout \
    || echo "$0: !! could not restore Game Mode autologin" >&2
exec /usr/bin/startplasma-wayland
